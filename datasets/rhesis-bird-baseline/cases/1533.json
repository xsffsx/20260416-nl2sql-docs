{
  "question": "For all the people who paid more than 29.00 per unit of product id No.5. Give their consumption status in the August of 2012.",
  "score": 0.0,
  "details": {
    "reason": "Complete results differ from Gold SQL; BIRD Soft F1 = 0.0",
    "BIRD_Soft_F1": 0.0,
    "actual_sql": "WITH aug_product_units AS (\n  SELECT\n    t.customer_id AS customer_id,\n    COUNT(*) AS units\n  FROM transactions_1k AS t\n  WHERE t.product_id = 5\n    AND t.date >= DATE '2012-08-01'\n    AND t.date < DATE '2012-09-01'\n  GROUP BY t.customer_id\n),\naug_consumption AS (\n  SELECT\n    y.customer_id AS customer_id,\n    y.consumption AS consumption\n  FROM yearmonth AS y\n  WHERE y.date = '201208'\n)\nSELECT\n  u.customer_id AS customer_id,\n  u.units AS units,\n  c.consumption AS consumption,\n  (c.consumption / u.units) AS consumption_per_unit\nFROM aug_product_units AS u\nJOIN aug_consumption AS c\n  ON c.customer_id = u.customer_id\nWHERE u.units > 0\n  AND (c.consumption / u.units) > 29.00\nORDER BY consumption_per_unit DESC",
    "gold_sql": "SELECT T2.consumption FROM transactions_1k AS T1 INNER JOIN yearmonth AS T2 ON T1.customer_id = T2.customer_id WHERE T1.price / NULLIF(T1.amount, 0) > 29.00 AND T1.product_id = 5 AND T2.date = '201208'",
