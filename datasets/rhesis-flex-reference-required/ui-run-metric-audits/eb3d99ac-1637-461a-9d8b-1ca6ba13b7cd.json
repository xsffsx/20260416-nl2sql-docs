{
  "id": "eb3d99ac-1637-461a-9d8b-1ca6ba13b7cd",
  "variant": "gold",
  "question": "For all the people who paid more than 29.00 per unit of product id No.5. Give their consumption status in the August of 2012.",
  "actual_sql": "SELECT\n  y.customer_id,\n  y.date AS period,\n  y.consumption,\n  CASE\n    WHEN y.consumption > 29.00 THEN 'Above 29.00'\n    WHEN y.consumption > 0 THEN 'Positive but at or below 29.00'\n    WHEN y.consumption = 0 THEN 'No consumption'\n    ELSE 'Negative consumption'\n  END AS consumption_status\nFROM yearmonth AS y\nWHERE y.date = '201208'\n  AND y.consumption > 29.00\n  AND EXISTS (\n    SELECT 1\n    FROM transactions_1k AS t\n    WHERE t.customer_id = y.customer_id\n      AND t.product_id = 5\n  )\nORDER BY y.consumption DESC,\n         y.customer_id ASC;",
  "actual_sql_sha256": "5a0381eaf45ad363cd1023d277873a826ebe9d5f10f79e84456913677d80ceae",
